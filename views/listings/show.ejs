<% layout("/layouts/boilerplate.ejs") %>

    <div class="row mt-3">

        <!-- Listing Title -->
        <div class="col-8 offset-2">
            <h3>
                <%= listing.title %>
            </h3>
        </div>

        <!-- Listing Card -->
        <div class="card col-6 offset-3 show-card listing-card">
            <% const defaultImg = "https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60"; %>
            <img src="<%= (listing.image && listing.image.url) ? listing.image.url : defaultImg %>" class="card-img-top show-img" alt="listing_image">

            <div class="card-body">
                <p class="card-text">Owned by <i><b>
                            <%= listing.owner ? listing.owner.username : "Anonymous" %>
                        </b>
                    </i></p>
                <p class="card-text">
                    <%= listing.description %>
                </p>
                <p class="card-text"> &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %>
                </p>
                <p class="card-text">
                    <%= listing.location %>
                </p>
                <p class="card-text">
                    <%= listing.country %>
                </p>
            </div>
        </div>
        <% if(currUser && listing.owner && listing.owner._id && listing.owner._id.equals(currUser._id)) { %>
            <!-- Edit & Delete -->

            <div class="col-6 offset-3 d-flex mt-3 mb-4">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-2 me-3">
                    Edit
                </a>

                <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                    <button class="btn btn-dark del-btn">
                        Delete
                    </button>
                </form>
            </div>
            <% } %>

                <!-- Review -->
                <div class="col-8 offset-2 mb-3">
                    <hr>
                    <% if(currUser){ %>
                        <h4>Leave a Review</h4>

                        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate
                            class="needs-validation">

                            <div class="mb-3 mt-3">
                                <label class="form-label d-block fw-semibold mb-1" for="rating">
                                    Rating
                                </label>
                                <div class="star-rating">
                                    <input type="radio" id="rate5" name="review[rating]" value="5" checked />
                                    <label for="rate5" title="5 stars - Amazing"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                                    <label for="rate4" title="4 stars - Very good"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate3" name="review[rating]" value="3" />
                                    <label for="rate3" title="3 stars - Average"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                                    <label for="rate2" title="2 stars - Not good"><i class="fa-solid fa-star"></i></label>

                                    <input type="radio" id="rate1" name="review[rating]" value="1" />
                                    <label for="rate1" title="1 star - Terrible"><i class="fa-solid fa-star"></i></label>
                                </div>
                            </div>

                            <div class="mb-3 mt-3">
                                <label class="form-label" for="comment">
                                    Comments
                                </label>

                                <textarea required cols="30" rows="5" name="review[comment]" id="comment"
                                    class="form-control"></textarea>

                                <div class="invalid-feedback">
                                    Please enter a comment.
                                </div>
                            </div>

                            <button class="btn btn-outline-dark">
                                Submit
                            </button>

                        </form>
                        <hr>
                        <% } %>

                            <p>
                                <b>All Reviews</b>
                            </p>

                            <div class="row">
                                <% for(review of listing.reviews) { %>
                                    <div class="card col-5 ms-3 mb-3">
                                        <div class="card-body">
                                            <h5 class="card-title">@<%= review.author ? review.author.username : "Anonymous" %>
                                            </h5>

                                            <div class="review-stars mb-2">
                                                <% for(let i = 1; i <= 5; i++) { %>
                                                    <% if(i <= review.rating) { %>
                                                        <i class="fa-solid fa-star"></i>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-star empty-star"></i>
                                                    <% } %>
                                                <% } %>
                                                <span class="ms-1 text-muted small">(<%= review.rating %>/5)</span>
                                            </div>

                                            <p class="card-text">
                                                <%= review.comment %>
                                            </p>
                                        </div>
                                        <% if(currUser && review.author && review.author._id && review.author._id.equals(currUser._id)) { %>
                                        <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
                                            method="post" class="mt-2 mb-2">
                                            <button class="btn btn-sm btn-dark">Delete</button>
                                        </form>
                                        <% } %>
                                    </div>
                                    <% } %>
                            </div>
                </div>

    </div>
